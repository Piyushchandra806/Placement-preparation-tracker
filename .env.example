# ==============================================================================
# Mission 90 — Environment Variables Example
# Duplicate this file as .env.local and fill in your actual credentials.
# NEVER commit .env.local or real secrets to version control.
# ==============================================================================

# MongoDB Atlas Connection URI (M0 Free Tier or higher)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/mission90?retryWrites=true&w=majority&appName=Cluster0

# MongoDB Database Name (defaults to 'mission90' if omitted)
MONGODB_DB=mission90

# JSON Web Token Secret for user authentication & sessions
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters_long

# Web Push Notification VAPID Keys (generate with npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_public_vapid_key_here
VAPID_PRIVATE_KEY=your_private_vapid_key_here_keep_secret
VAPID_SUBJECT=mailto:admin@example.com
